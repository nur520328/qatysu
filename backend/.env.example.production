# Сервердегі баптау үлгісі. Орналастырғанда осы файлдың көшірмесін `.env` деп атап,
# тек DB_PASSWORD жолын толтырасыз. APP_KEY бос қалады: оны орнату командасы өзі жасайды.
# `.env` файлы ешқашан чатқа, поштаға не GitHub-қа жіберілмейді.

APP_NAME=Qatysu
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://qatysu.chemstry.kz

APP_LOCALE=kk
APP_FALLBACK_LOCALE=kk
APP_TIMEZONE=Asia/Almaty

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=p-337556_qatysu
DB_USERNAME=p-337556_nur520328
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie тек HTTPS арқылы жіберіледі.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
